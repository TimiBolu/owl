CREATE CONSTRAINT IF NOT EXISTS FOR (n:Org) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Unit) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Person) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Project) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Task) REQUIRE n.id IS UNIQUE;
CREATE INDEX IF NOT EXISTS FOR (n:Person) ON (n.level);
CREATE INDEX IF NOT EXISTS FOR (n:Project) ON (n.state);
CREATE INDEX IF NOT EXISTS FOR (n:Task) ON (n.state, n.opened);
CALL db.awaitIndexes(120);
LOAD CSV WITH HEADERS FROM 'file:///orgs.csv' AS r CREATE (:Org {id: r.id, name: r.name, plan: r.plan, region: r.region});
LOAD CSV WITH HEADERS FROM 'file:///units.csv' AS r CREATE (:Unit {id: r.id, name: r.name, budget: toFloat(r.budget)});
LOAD CSV WITH HEADERS FROM 'file:///people.csv' AS r CREATE (:Person {id: r.id, name: r.name, level: toInteger(r.level), salary: toFloat(r.salary), hired: r.hired, departed: r.departed});
LOAD CSV WITH HEADERS FROM 'file:///projects.csv' AS r CREATE (:Project {id: r.id, name: r.name, state: r.state, budget: toFloat(r.budget), started: r.started});
LOAD CSV WITH HEADERS FROM 'file:///tasks.csv' AS r CREATE (:Task {id: r.id, state: r.state, points: toInteger(r.points), opened: r.opened, closed: r.closed});
LOAD CSV WITH HEADERS FROM 'file:///units.csv' AS r MATCH (u:Unit {id: r.id}), (o:Org {id: r.org}) CREATE (u)-[:OF_ORG]->(o);
LOAD CSV WITH HEADERS FROM 'file:///units.csv' AS r WITH r WHERE r.parent IS NOT NULL MATCH (u:Unit {id: r.id}), (p:Unit {id: r.parent}) CREATE (u)-[:CHILD_OF]->(p);
LOAD CSV WITH HEADERS FROM 'file:///people.csv' AS r MATCH (p:Person {id: r.id}), (o:Org {id: r.org}), (u:Unit {id: r.unit}) CREATE (p)-[:OF_ORG]->(o), (p)-[:IN_UNIT]->(u);
LOAD CSV WITH HEADERS FROM 'file:///people.csv' AS r WITH r WHERE r.manager IS NOT NULL MATCH (p:Person {id: r.id}), (m:Person {id: r.manager}) CREATE (p)-[:REPORTS_TO]->(m);
LOAD CSV WITH HEADERS FROM 'file:///projects.csv' AS r MATCH (j:Project {id: r.id}), (o:Org {id: r.org}), (p:Person {id: r.owner}) CREATE (j)-[:OF_ORG]->(o), (j)-[:OWNED_BY]->(p);
LOAD CSV WITH HEADERS FROM 'file:///tasks.csv' AS r MATCH (t:Task {id: r.id}), (j:Project {id: r.project}) CREATE (t)-[:IN_PROJECT]->(j);
LOAD CSV WITH HEADERS FROM 'file:///tasks.csv' AS r WITH r WHERE r.assignee IS NOT NULL MATCH (t:Task {id: r.id}), (p:Person {id: r.assignee}) CREATE (t)-[:ASSIGNED_TO]->(p);
LOAD CSV WITH HEADERS FROM 'file:///tasks.csv' AS r WITH r WHERE r.parent IS NOT NULL MATCH (t:Task {id: r.id}), (p:Task {id: r.parent}) CREATE (t)-[:SUBTASK_OF]->(p);
LOAD CSV WITH HEADERS FROM 'file:///assignments.csv' AS r MATCH (p:Person {id: r.person}), (j:Project {id: r.project}) CREATE (p)-[:WORKS_ON {id: r.id, role: r.role, hours: toInteger(r.hours)}]->(j);
LOAD CSV WITH HEADERS FROM 'file:///links.csv' AS r MATCH (a:Task {id: r.blocker}), (b:Task {id: r.blocked}) CREATE (a)-[:BLOCKS {id: r.id, kind: r.kind}]->(b);
