    salary: 150000,
    active: true
}

Employee.insert {
    id: "emp2",
    name: "Bob Smith",
    email: "bob@innovate.com",
    department: "research",
    salary: 120000,
    active: true
}

Employee.insert {
    id: "emp3",
    name: "Charlie Chen",
    email: "charlie@futuretech.jp",
    department: "ai",
    salary: 180000,
    active: true
}

Employee.insert {
    id: "emp4",
    name: "Diana Martinez",
    email: "diana@techcorp.com",
    department: "eng",
    salary: 140000,
    active: true
}

// Insert data - Projects
Project.insert {
    id: "proj1",
    title: "Cloud Migration",
    description: "Migrate all services to cloud infrastructure",
    lead: "emp1",
    department: "eng",
    budget: 2000000,
    status: "active"
}

Project.insert {
    id: "proj2",
    title: "Quantum Computing Research",
    description: "Explore quantum computing applications",
    lead: "emp2",
    department: "research",
    budget: 1500000,
    status: "active"
}

Project.insert {
    id: "proj3",
    title: "Neural Network Optimization",
    description: "Optimize deep learning models for production",
    lead: "emp3",
    department: "ai",
    budget: 3000000,
    status: "planning"
}

// Query 1: Simple query - all projects
Project

// Query 2: Deep navigation - project with full context
Project.select {
    id,
    title,
    status,
    budget,
    lead_name: .lead.name,
    lead_email: .lead.email,
    lead_salary: .lead.salary,
    dept_name: .department.name,
    dept_budget: .department.budget,
    company_name: .department.company.name,
    company_founded: .department.company.founded,
    city_name: .department.company.headquarters.name,
    city_population: .department.company.headquarters.population,
    country_name: .department.company.headquarters.country.name,
    country_code: .department.company.headquarters.country.code
}

// Query 3: Multiple reference paths
Project.select {
    title,
    lead_dept: .lead.department.name,
    lead_company: .lead.department.company.name,
    lead_city: .lead.department.company.headquarters.name,
    project_dept: .department.name,
    project_company: .department.company.name,
    project_city: .department.company.headquarters.name
}

// Query 4: Simple aggregations
Project.count()

Project.sum(.budget)

Project.avg(.budget)

// Query 5: Filter with deep navigation
Project.where { .department.company.headquarters.country.code == "US" }.select {
    title,
    lead_name: .lead.name,
    company: .department.company.name,
    country: .department.company.headquarters.country.name
}
