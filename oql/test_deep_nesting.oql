// Deep Nesting Test - Multiple schemas with references forming deep hierarchies

// Define schemas with references
schema Country {
    id: String,
    name: String,
    code: String
}

schema City {
    id: String,
    name: String,
    country: Country,
    population: Integer
}

schema Company {
    id: String,
    name: String,
    headquarters: City,
    founded: Integer
}

schema Department {
    id: String,
    name: String,
    company: Company,
    budget: Integer
}

schema Employee {
    id: String,
    name: String,
    email: String,
    department: Department,
    salary: Integer,
    active: Boolean
}

schema Project {
    id: String,
    title: String,
    description: String,
    lead: Employee,
    department: Department,
    budget: Integer,
    status: String
}

// Insert data - Countries
Country.insert {
    id: "usa",
    name: "United States",
    code: "US"
}

Country.insert {
    id: "uk",
    name: "United Kingdom",
    code: "GB"
}

Country.insert {
    id: "japan",
    name: "Japan",
    code: "JP"
}

// Insert data - Cities
City.insert {
    id: "nyc",
    name: "New York",
    country: "usa",
    population: 8336817
}

City.insert {
    id: "london",
    name: "London",
    country: "uk",
    population: 8982000
}

City.insert {
    id: "tokyo",
