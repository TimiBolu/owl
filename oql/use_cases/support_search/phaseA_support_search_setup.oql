// Phase A - Support Knowledge Search
// Setup script: schemas + seed data (refs + nested metadata + vectors)

schema organizations {
  id: String,
  name: String,
  profile: Object
}

schema teams {
  id: String,
  org: Ref(organizations),
  name: String,
  settings: Object
}

schema kb_articles {
  id: String,
  team: Ref(teams),
  title: String,
  status: String,
  tags: List(String),
  meta: Object
}

schema kb_chunks {
  id: String,
  article: Ref(kb_articles),
  team: Ref(teams),
  org: Ref(organizations),
  chunk_index: Integer,
  status: String,
  chunk_text: String,
  tags: List(String),
  meta: Object,
  embedding: Vector(4)
}

organizations.insert [
  { id: "org_1", name: "Northwind", profile: { region: "west", tier: "enterprise" } },
  { id: "org_2", name: "Contoso", profile: { region: "east", tier: "growth" } }
]

teams.insert [
  { id: "team_payments", org: "org_1", name: "Payments", settings: { timezone: "UTC", lang: "en" } },
  { id: "team_infra", org: "org_1", name: "Infra", settings: { timezone: "UTC+1", lang: "en" } },
  { id: "team_commerce", org: "org_2", name: "Commerce", settings: { timezone: "UTC-5", lang: "en" } }
]

kb_articles.insert [
  { id: "art_cb_001", team: "team_payments", title: "Chargeback dispute workflow", status: "published", tags: ["payments", "risk"], meta: { source: "runbook", lang: "en", updated_at: "2026-02-21T12:10:00Z" } },
  { id: "art_rf_001", team: "team_payments", title: "Refund processing policy", status: "published", tags: ["payments", "refunds"], meta: { source: "policy", lang: "en", updated_at: "2026-02-19T09:00:00Z" } },
  { id: "art_k8s_001", team: "team_infra", title: "Kubernetes node pressure runbook", status: "published", tags: ["infra", "kubernetes"], meta: { source: "runbook", lang: "en", updated_at: "2026-02-20T16:45:00Z" } },
  { id: "art_idx_001", team: "team_commerce", title: "Catalog indexing lag playbook", status: "draft", tags: ["search", "commerce"], meta: { source: "playbook", lang: "en", updated_at: "2026-02-18T11:30:00Z" } }
]

